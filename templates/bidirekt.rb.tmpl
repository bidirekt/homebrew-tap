class Bidirekt < Formula
  desc "CLI for Bidirekt, bidirectional contract testing"
  homepage "https://bidirekt.com"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "{{BASE_URL}}/bidirekt_{{VERSION}}_darwin_arm64.tar.gz"
      sha256 "{{SHA256_DARWIN_ARM64}}"
    end
    on_intel do
      url "{{BASE_URL}}/bidirekt_{{VERSION}}_darwin_amd64.tar.gz"
      sha256 "{{SHA256_DARWIN_AMD64}}"
    end
  end

  on_linux do
    on_arm do
      url "{{BASE_URL}}/bidirekt_{{VERSION}}_linux_arm64.tar.gz"
      sha256 "{{SHA256_LINUX_ARM64}}"
    end
    on_intel do
      url "{{BASE_URL}}/bidirekt_{{VERSION}}_linux_amd64.tar.gz"
      sha256 "{{SHA256_LINUX_AMD64}}"
    end
  end

  def install
    bin.install "bidirekt"
  end

  test do
    assert_match "bidirekt version #{version}", shell_output("#{bin}/bidirekt --version")
  end
end
